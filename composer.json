{
    "name": "knight-swarm/laravel-saml",
    "description": "saml auth provider for laravel 5.*",
    "keywords": [
        "saml",
        "laravel",
        "laravel-saml",
        "sso"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "KnightSwarm Handelsbolag",
            "email": "code@knightswarm.com"
        },
        {
            "name": "Tom Mount",
            "email": "tmountjr@gmail.com"
        },
        {
            "name": "Phil Preston",
            "email": "phpreston@ebay.com"
        },
        {
            "name": "Jeremy French",
            "email": "jeremy@jeremyfrench.co.uk"
        }
    ],
    "require": {
        "php": ">=5.3.0",
        "illuminate/support": "~5.0"
    },
    "require-dev": {
        "illuminate/support": "~5.0",
        "illuminate/auth": "~5.0",
        "illuminate/config": "~5.0",
        "illuminate/cookie": "~5.0"
    },
    "autoload": {
        "classmap": [
            "src/controllers"
        ],
        "psr-0": {
            "KnightSwarm\\LaravelSaml": "src/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "7.1.33"
        },
        "audit": {
            "abandoned": "ignore"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}